.search-page {
  padding: 16rpx 0;
}
.search-page__bar {
  padding: 0 24rpx 24rpx;
  background: var(--color-bg-card);
}
.search-page__section {
  background: var(--color-bg-card);
  padding: 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
}
.search-page__title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: var(--color-text-primary);
}
.search-page__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-spacing { margin-right: 8rpx; margin-bottom: 8rpx; }
.search-page__results { padding: 16rpx 24rpx; }
.search-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: var(--color-text-tertiary);
}
.search-page__empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}
.search-page__empty-text {
  font-size: 26rpx;
}