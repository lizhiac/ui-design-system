<view class="page">
  <h1 class="page__title">Cell 列表演示</h1>
  <p class="page__desc">Vant Cell + 自建 Cell 对比</p>

  <!-- Vant Cell：完整功能 -->
  <view class="section">
    <view class="section__title">Vant Cell（推荐）</view>
    <van-cell-group title="账户设置" inset>
      <van-cell title="个人资料" label="头像、昵称、简介" is-link icon="user-o" />
      <van-cell title="账号安全" label="手机号、密码" is-link icon="shield-o" />
      <van-cell title="消息通知" is-link icon="bell" />
      <van-cell title="关于我们" is-link border="{{ false }}" icon="info-o" />
    </van-cell-group>

    <van-cell-group title="订单相关" inset custom-class="mt">
      <van-cell title="我的订单" value="3" is-link icon="orders-o" />
      <van-cell title="优惠券" value="5 张" is-link icon="coupon-o" />
      <van-cell title="收货地址" is-link icon="location-o" bind:click="goAddress" />
      <van-cell title="发票抬头" is-link border="{{ false }}" icon="description" />
    </van-cell-group>
  </view>

  <!-- 自建 Cell：基础款 -->
  <view class="section">
    <view class="section__title">自建 Cell（基础款）</view>
    <ui-cell title="个人资料" label="头像、昵称" value="李某某" is-link border />
    <ui-cell title="账号安全" is-link border />
    <ui-cell title="关于我们" is-link border="{{ false }}" />
  </view>
</view>