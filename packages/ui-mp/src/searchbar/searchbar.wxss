.ui-searchbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: var(--color-bg-card, #FFFFFF);
}

.ui-searchbar__input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  height: 72rpx;
  position: relative;
}

.ui-searchbar__input-wrap--round {
  border-radius: 36rpx;
}
.ui-searchbar__input-wrap--square {
  border-radius: 8rpx;
}

.ui-searchbar__icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}
.ui-searchbar__icon-circle {
  position: absolute;
  top: 0;
  left: 0;
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid var(--color-text-tertiary, #86909C);
  border-radius: 50%;
  box-sizing: border-box;
}
.ui-searchbar__icon-line {
  position: absolute;
  bottom: 2rpx;
  right: 0;
  width: 12rpx;
  height: 4rpx;
  background: var(--color-text-tertiary, #86909C);
  transform: rotate(45deg);
  transform-origin: right bottom;
}

.ui-searchbar__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary, #1D2129);
  height: 100%;
  min-width: 0;
}

.ui-searchbar__placeholder {
  color: var(--color-text-placeholder, #C9CDD4);
}

/* 清除按钮 */
.ui-searchbar__clear {
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
  background: var(--color-text-tertiary, #86909C);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ui-searchbar__clear--hover {
  opacity: 0.7;
}
.ui-searchbar__clear-icon {
  position: relative;
  width: 16rpx;
  height: 16rpx;
}
.ui-searchbar__clear-icon::before,
.ui-searchbar__clear-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16rpx;
  height: 2rpx;
  background: #fff;
}
.ui-searchbar__clear-icon::before { transform: translate(-50%, -50%) rotate(45deg); }
.ui-searchbar__clear-icon::after  { transform: translate(-50%, -50%) rotate(-45deg); }

/* action */
.ui-searchbar__action {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: var(--color-text-primary, #1D2129);
  white-space: nowrap;
}
.ui-searchbar__action--hover {
  opacity: 0.6;
}