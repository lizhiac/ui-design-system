.ui-tabbar {
  width: 100%;
  box-sizing: border-box;
}
.ui-tabbar--fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
}

.ui-tabbar__items {
  display: flex;
  align-items: center;
  justify-content: space-around;
  min-height: 96rpx;
  padding: 8rpx 0;
}

.ui-tabbar__border {
  height: 2rpx;
  background: var(--color-border-light, #F2F3F5);
}

.ui-tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0;
  transition: background 0.15s;
}
.ui-tabbar__item--hover {
  background: var(--color-bg-container-hover, #F7F8FA);
}

.ui-tabbar__icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

.ui-tabbar__icon {
  transition: opacity 0.2s;
}
.ui-tabbar__icon--hide {
  opacity: 0;
  position: absolute;
}

.ui-tabbar__label {
  font-size: 22rpx;
  line-height: 1.2;
  margin-top: 4rpx;
  font-weight: 500;
}

/* 角标 */
.ui-tabbar__badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--color-brand-danger, #F53F3F);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 2rpx solid var(--color-bg-card, #FFFFFF);
  box-sizing: border-box;
}

/* 红点 */
.ui-tabbar__dot {
  position: absolute;
  top: 0;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--color-brand-danger, #F53F3F);
  border-radius: 50%;
  border: 2rpx solid var(--color-bg-card, #FFFFFF);
  box-sizing: border-box;
}

.ui-tabbar__placeholder {
  height: 96rpx;
}